{
  "id": "commit-graph",
  "name": "Commit graph",
  "version": "0.1.0",
  "description": "A year of the checkout's commits as a calendar of squares under the composer, deeper violet the busier the day.",
  "icon": "icon.svg",
  "entry": "init.luau",
  "service": "service.luau",
  "permissions": [
    "ui.add",
    "sessions.read",
    "files.read",
    "service",
    "commands"
  ],
  "commands": [
    "git"
  ],
  "settings": [
    {
      "id": "show",
      "kind": "switch",
      "label": "Show the graph",
      "description": "The recent commits' graph under each chat's composer.",
      "default": true
    },
    {
      "id": "all_branches",
      "kind": "switch",
      "label": "All branches",
      "description": "Draw every branch, remote and tag, not just this branch, its upstream and base.",
      "default": false
    }
  ],
